    "import matplotlib.pyplot as plt\n",
    "\n",
    "time = [8, 7, 9, 5, 8, 7, 10, 11, 12, 14, 4, 3]\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "plt.hist(time, bins=4)\n",
    "\n",
    "plt.xlabel(\"Time spent\")\n",
    "plt.ylabel(\"No. of students\")\n",
    "plt.title(\"Time spent by students on mobile\")\n",
    "plt.grid()\n",
    "\n",
    "plt.show()"
   ]
